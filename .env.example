# ATES reads the process environment. Leave unused settings unset.

# Database connections (SQLAlchemy URLs)
# ATES_DATABASE_URL=
# ATES_MIGRATION_DATABASE_URL=
# ATES_WORKER_DATABASE_URL=

# Authentication and local bootstrap
# ATES_JWT_SECRET=
# ATES_BOOTSTRAP_PASSWORD=

# Optional application settings
# ATES_FRONTEND_ORIGIN=
# ATES_FIRST_WEEKDAY=
# ATES_INSTITUTION=
# ATES_PDF_FONT=
# ATES_BACKUP_DIRECTORY=
# ATES_PG_BIN=

# Optional local verification settings
# ATES_TEST_DATABASE_URL=
# ATES_BROWSER_CHANNEL=
